{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/latetedemelon/banker/spec/schemas/account.schema.json",
  "title": "Account",
  "description": "A logical account a source can enumerate (used by list-accounts). 'balance' follows the same Decimal-as-string rule as Transaction.amount.",
  "type": "object",
  "required": ["id"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "description": "Source-side account identifier (matches Transaction.account_id)."
    },
    "name": {"type": "string", "default": ""},
    "currency": {
      "type": "string",
      "default": "",
      "description": "ISO-4217 code, lower-cased (may be empty if unknown)."
    },
    "type": {
      "type": "string",
      "default": "",
      "description": "Free-form account type, e.g. 'checking', 'savings', 'credit'."
    },
    "balance": {
      "type": ["string", "null"],
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
      "default": null
    }
  }
}
